<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_kot_print_config" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherited</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='pos_interface_section']" position="inside">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="kot"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="kot"/>
                            <div class="text-muted">
                                Enable the KOT PRINT for kitchen orders to generate it.
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

    

