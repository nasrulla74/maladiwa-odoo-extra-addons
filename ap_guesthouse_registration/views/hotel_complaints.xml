<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="action_appeul_hotel_complaints" model="ir.actions.act_window">
        <field name="name">Hotel Complaints</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hotel.complain</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Complaints!!
            </p>
        </field>
    </record>

 <record id="view_appeul_hotel_complaints_form" model="ir.ui.view">
        <field name="name">view.appeul.hotel.complaints.form</field>
        <field name="model">hotel.complain</field>
        <field name="arch" type="xml">
            <form>
                <header>
<!--                    <button name="action_check_out" type="object" string="Check-Out" attrs="{'invisible': [('reg_state', 'in', ['checked-out'])]}"/>-->
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="guest_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="name" invisible="1"/>
                            <field name="c_date"/>
                            <field name="c_state"/>
                        </group>
                        <group>
                            <field name="complain"/>
                            <field name="complete_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_appeul_hotel_complaints_tree" model="ir.ui.view">
        <field name="name">view.appeul.hotel.complaints.tree</field>
        <field name="model">hotel.complain</field>
        <field name="arch" type="xml">
            <tree export_xlsx ="1" create="1">
                            <field name="guest_id"/>
                            <field name="name" invisible="1"/>
                            <field name="c_date"/>
                            <field name="complain"/>
                            <field name="c_state"/>
                            <field name="complete_at"/>
           </tree>
        </field>
    </record>


 <!-- search view -->
    <record id="view_gh_hotel_complain_search" model="ir.ui.view">
        <field name="name">view.gh.hotel.complain.search</field>
        <field name="model">hotel.complain</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="complaint_draft_filter" string="Draft" domain="[('c_state', '=', 'draft')]" />
                <filter name="complaint_done_filter" string="Done" domain="[('c_state', '=', 'done')]" />
                <searchpanel>
                    <field name="c_state" enable_counters="1" />
                </searchpanel>
           </search>
        </field>
    </record>

   <menuitem id="listmenu_hotel_complain"
              name="Guest Complaints"
              action="action_appeul_hotel_complaints"
              parent="menu_guesthouse_root"
              sequence="12"/>
   </odoo>