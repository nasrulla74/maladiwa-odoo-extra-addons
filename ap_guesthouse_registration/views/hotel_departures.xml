    <record id="appeul_register_today_departure_tree" model="ir.ui.view">
        <field name="name">appeul.register.today.departure.tree</field>
        <field name="model">hotel.register</field>
        <field name="arch" type="xml">
            <tree export_xlsx ="0" create="0">
                <field name="reg_no"/>
                <field name="room_id"/>
                <field name="guest_id" string="Guest Name"/>
                <field name="arr_date" />
                <field name="dep_date" />
                <field name="meal_id" />
                <field name="rm_cat_id" />
                <field name="country_id" />
                <field name="identification_no" />
                <field name="date_of_birth" />
                <field name="bk_method"/>
                <field name="reg_state" />
                <field name="booking_id" />
                <field name="booking_ref"/>
                <field name="name"/>
           </tree>
        </field>
    </record>



<record id="action_register_today_departure" model="ir.actions.act_window">
        <field name="name">Today's Departures</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hotel.register</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="appeul_hotel_booking_departure_search"/>
        <field name="domain">[('reg_state', 'in', ['checked-in'])]</field>
        <field name="context">{'search_default_filter_today_departure': 1}</field>

        <field name="view_ids"
                eval="[(5, 0, 0),
                    (0, 0, {'sequence': 2, 'view_mode': 'tree', 'view_id': ref('appeul_register_today_departure_tree')}),
                    (0, 0, {'sequence': 3, 'view_mode': 'form', 'view_id': ref('view_appeul_hotel_register_form')}),
                ]"/>


        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Departures today!!
            </p>
        </field>
    </record>


    <menuitem id="listmenu_today_departure"
              name="Departures"
              action="action_register_today_departure"
              parent="menu_guesthouse_root"
              sequence="6"/>




