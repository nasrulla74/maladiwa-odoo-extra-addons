<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="action_appeul_hotel_activities" model="ir.actions.act_window">
        <field name="name">Hotel Activities</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hotel.ex.activities</field>
        <field name="view_mode">tree,form</field>
<!--        <field name="context">{"search_default_roomno":1}</field>-->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create activities!!
            </p>
        </field>
    </record>

 <record id="view_appeul_hotel_activities_form" model="ir.ui.view">
        <field name="name">view.appeul.hotel.activities.form</field>
        <field name="model">hotel.ex.activities</field>
        <field name="arch" type="xml">
            <form>
                <header>
<!--                    <button name="action_check_out" type="object" string="Check-Out" attrs="{'invisible': [('reg_state', 'in', ['checked-out'])]}"/>-->

                </header>
                
                <sheet>
                   
                    <group>
                        <group>
                            <field name="guest_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" />
                            <field name="name" invisible="1"/>
                            <field name="ac_date"/>
                            <field name="provider_id" />
                        </group>
                        <group>

                            <field name="ac_type" />
                            <field name="ac_state"/>
                            <field name="remarks"/>

                        </group>
                    </group>
                    

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_appeul_hotel_activities_tree" model="ir.ui.view">
        <field name="name">view.appeul.hotel.activities.tree</field>
        <field name="model">hotel.ex.activities</field>
        <field name="arch" type="xml">
            <tree export_xlsx ="0" create="1">
                <field name="guest_id"/>
                            <field name="name" invisible="1"/>
                            <field name="ac_date"/>
                            <field name="provider_id" />
                            <field name="ac_type" />
                            <field name="ac_state"/>
                            <field name="remarks"/>


           </tree>
        </field>
    </record>

    
 <!-- search view -->
    <record id="view_gh_hotel_activities_search" model="ir.ui.view">
        <field name="name">view.gh.hotel.activities.search</field>
        <field name="model">hotel.ex.activities</field>
        <field name="arch" type="xml">
            <search>
                <field name="guest_id"/>
                <field name="name"/>
                <filter name="ap_state_draft_filter" string="Draft" domain="[('ac_state', '=', 'draft')]" />
                <filter name="ap_state_done_filter" string="Done" domain="[('ac_state', '=', 'done')]" />
                <filter name="ap_state_billed_filter" string="Billed" domain="[('ac_state', '=', 'billed')]" />
                <searchpanel>
                    <field name="ac_state" enable_counters="1" />
                </searchpanel>

           </search>
        </field>
    </record>
    


   <menuitem id="listmenu_hotel_activities"
              name="Guest Activities"
              action="action_appeul_hotel_activities"
              parent="menu_guesthouse_root"
              sequence="11"/>
    

              
   </odoo>